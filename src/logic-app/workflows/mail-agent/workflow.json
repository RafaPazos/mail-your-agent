{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_new_email_arrives": {
        "type": "ApiConnectionNotification",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "office365"
            }
          },
          "fetch": {
            "method": "get",
            "pathTemplate": {
              "template": "/v3/Mail/OnNewEmail"
            },
            "queries": {
              "fetchOnlyWithAttachment": false,
              "folderPath": "Inbox",
              "importance": "Any",
              "includeAttachments": true,
              "subjectFilter": "@appsetting('MAIL_TRIGGER_PHRASE')"
            }
          },
          "subscribe": {
            "method": "post",
            "pathTemplate": {
              "template": "/GraphMailSubscriptionPoke/$subscriptions"
            },
            "body": {
              "NotificationUrl": "@{listCallbackUrl()}"
            },
            "queries": {
              "fetchOnlyWithAttachment": false,
              "folderPath": "Inbox",
              "importance": "Any"
            }
          }
        },
        "splitOn": "@triggerBody()?['value']"
      }
    },
    "actions": {
      "Initialize_pdf_extracted_text": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name": "pdf_extracted_text",
              "type": "string",
              "value": ""
            }
          ]
        }
      },
      "Check_subject_prefix": {
        "type": "If",
        "runAfter": {
          "Initialize_pdf_extracted_text": [
            "Succeeded"
          ]
        },
        "expression": {
          "and": [
            {
              "contains": [
                "@toLower(coalesce(triggerBody()?['subject'], ''))",
                "@toLower(appsetting('MAIL_TRIGGER_PHRASE'))"
              ]
            },
            {
              "not": {
                "startsWith": [
                  "@toLower(trim(coalesce(triggerBody()?['subject'], '')))",
                  "re:"
                ]
              }
            }
          ]
        },
        "else": {
          "actions": {}
        },
        "actions": {
          "Filter_pdf_attachments": {
            "type": "Query",
            "runAfter": {},
            "inputs": {
              "from": "@coalesce(triggerBody()?['attachments'], createArray())",
              "where": "@equals(toLower(coalesce(item()?['contentType'], '')), 'application/pdf')"
            }
          },
          "Check_has_pdf_attachment": {
            "type": "If",
            "runAfter": {
              "Filter_pdf_attachments": [
                "Succeeded"
              ]
            },
            "expression": {
              "greater": [
                "@length(body('Filter_pdf_attachments'))",
                0
              ]
            },
            "else": {
              "actions": {}
            },
            "actions": {
              "Analyze_pdf_content": {
                "type": "Http",
                "runAfter": {},
                "inputs": {
                  "method": "POST",
                  "uri": "@concat(appsetting('CONTENT_UNDERSTANDING_ENDPOINT'), '/contentunderstanding/analyzers/prebuilt-documentSearch:analyzeBinary?api-version=2025-11-01')",
                  "headers": {
                    "Content-Type": "application/octet-stream"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://cognitiveservices.azure.com"
                  },
                  "body": "@base64ToBinary(first(body('Filter_pdf_attachments'))?['contentBytes'])",
                  "operationOptions": "DisableAsyncPattern"
                },
                "runtimeConfiguration": {
                  "contentTransfer": {
                    "transferMode": "Chunked"
                  }
                }
              },
              "Until_pdf_analysis_complete": {
                "type": "Until",
                "runAfter": {
                  "Analyze_pdf_content": [
                    "Succeeded"
                  ]
                },
                "expression": "@or(equals(body('Get_pdf_analysis_result')?['status'], 'Succeeded'), equals(body('Get_pdf_analysis_result')?['status'], 'Failed'))",
                "limit": {
                  "count": 30,
                  "timeout": "PT1M"
                },
                "actions": {
                  "Delay_before_poll": {
                    "type": "Wait",
                    "runAfter": {},
                    "inputs": {
                      "interval": {
                        "count": 2,
                        "unit": "Second"
                      }
                    }
                  },
                  "Get_pdf_analysis_result": {
                    "type": "Http",
                    "runAfter": {
                      "Delay_before_poll": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "method": "GET",
                      "uri": "@outputs('Analyze_pdf_content')?['headers']?['Operation-Location']",
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://cognitiveservices.azure.com"
                      }
                    }
                  }
                }
              },
              "Set_pdf_extracted_text": {
                "type": "SetVariable",
                "runAfter": {
                  "Until_pdf_analysis_complete": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "name": "pdf_extracted_text",
                  "value": "@if(and(equals(body('Get_pdf_analysis_result')?['status'], 'Succeeded'), greater(length(coalesce(body('Get_pdf_analysis_result')?['result']?['contents'], createArray())), 0)), first(body('Get_pdf_analysis_result')?['result']?['contents'])?['markdown'], '')"
                }
              }
            }
          },
          "Call_Foundry_agent": {
            "type": "Http",
            "runAfter": {
              "Check_has_pdf_attachment": [
                "Succeeded",
                "Skipped",
                "Failed",
                "TimedOut"
              ]
            },
            "inputs": {
              "method": "POST",
              "uri": "@concat(appsetting('FOUNDRY_PROJECT_ENDPOINT'), '/openai/v1/responses')",
              "headers": {
                "Content-Type": "application/json"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://ai.azure.com"
              },
              "body": {
                "agent_reference": {
                  "name": "@appsetting('FOUNDRY_AGENT_NAME')",
                  "type": "agent_reference"
                },
                "input": "@concat('Subject: ', coalesce(triggerBody()?['subject'], '(no subject)'), decodeUriComponent('%0A%0A'), coalesce(triggerBody()?['body'], triggerBody()?['bodyPreview'], ''), if(greater(length(variables('pdf_extracted_text')), 0), concat(decodeUriComponent('%0A%0A'), 'Attached PDF content:', decodeUriComponent('%0A'), variables('pdf_extracted_text')), ''))"
              }
            },
            "runtimeConfiguration": {
              "contentTransfer": {
                "transferMode": "Chunked"
              }
            }
          },
          "Filter_response_messages": {
            "type": "Query",
            "runAfter": {
              "Call_Foundry_agent": [
                "Succeeded"
              ]
            },
            "inputs": {
              "from": "@body('Call_Foundry_agent')?['output']",
              "where": "@equals(item()?['type'], 'message')"
            }
          },
          "Reply_to_email": {
            "type": "ApiConnection",
            "runAfter": {
              "Filter_response_messages": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "office365"
                }
              },
              "method": "post",
              "path": "/v3/Mail/ReplyTo/@{encodeURIComponent(triggerBody()?['id'])}",
              "body": {
                "Body": "@concat('<p>Answer from ', appsetting('FOUNDRY_AGENT_NAME'), ':</p><pre style=\"white-space:pre-wrap\">', replace(replace(replace(coalesce(first(body('Filter_response_messages'))?['content']?[0]?['text'], 'The agent returned no text response.'), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '</pre>')",
                "Importance": "Normal",
                "ReplyAll": false
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
